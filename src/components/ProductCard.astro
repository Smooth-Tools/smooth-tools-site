---
interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
  cta?: string;
}

const { title, description, href, eyebrow, cta = 'View details' } = Astro.props;
---

<article class="product-card">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h3>{title}</h3>
  <p>{description}</p>
  <a class="text-link" href={href}>{cta}</a>
</article>
