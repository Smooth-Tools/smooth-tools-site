---
import { smoothOperatorAssetStoreUrl } from '../data/site';
import { withBase } from '../lib/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand brand-footer" href={withBase()}>
        <img src={withBase('images/smooth-tools-icon.png')} alt="" width="32" height="32" />
        <span>
          <strong>Smooth Tools</strong>
          <small>Small, focused tools for Unity developers.</small>
        </span>
      </a>
    </div>
    <div class="footer-links">
      <a href={withBase('/products/background-build')}>Background Build</a>
      <a href={withBase('/products/smoothoperator')}>Smooth Operator</a>
      <a href={withBase('/support')}>Support</a>
      <a href={smoothOperatorAssetStoreUrl} target="_blank" rel="noreferrer">Asset Store</a>
    </div>
  </div>
</footer>
