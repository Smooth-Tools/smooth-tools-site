---
import BaseLayout from '../layouts/BaseLayout.astro';
import { backgroundBuildEnabled, smoothOperatorAssetStoreUrl } from '../data/site';

const supportEmail = 'smoothtooling@gmail.com';
---

<BaseLayout
  title="Support"
  description="Support expectations and the technical details to include when reaching out about Smooth Tools products."
  path="/support"
>
  <section class="hero">
    <div class="shell hero-copy">
      <p class="eyebrow">Support</p>
      <h1>We are here to help.</h1>
      <p>
        Use the form below to get in touch. It helps collect the details that usually matter most
        when tracking down Unity tooling issues, so support can be faster and more useful.
      </p>
      <div class="button-row">
        <a class="button-quiet" href={`mailto:${supportEmail}`}>{supportEmail}</a>
        <a class="button" href={smoothOperatorAssetStoreUrl} target="_blank" rel="noreferrer">
          Smooth Operator Asset Store
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell support-layout">
      <section class="support-form-card">
        <div class="section-copy">
          <p class="eyebrow">Contact Form</p>
          <h2>Draft a support email</h2>
          <p>
            This form uses your email app. Fill in the fields, hit send, and your message will be
            addressed to Smooth Tools with the right structure.
          </p>
        </div>

        <form class="support-form" action={`mailto:${supportEmail}`} method="post" enctype="text/plain">
          <div class="form-grid">
            <label class="form-field">
              <span>Name</span>
              <input type="text" name="Name" autocomplete="name" />
            </label>

            <label class="form-field">
              <span>Email</span>
              <input type="email" name="Email" autocomplete="email" />
            </label>

            <label class="form-field">
              <span>Product name</span>
              <select name="Product">
                <option>Smooth Operator</option>
                {backgroundBuildEnabled && <option>Background Build</option>}
                <option>Other</option>
              </select>
            </label>

            <label class="form-field">
              <span>Unity version</span>
              <input type="text" name="Unity Version" placeholder="Example: 2022.3.41f1" />
            </label>

            <label class="form-field">
              <span>Platform or build target</span>
              <input type="text" name="Platform or Build Target" placeholder="Example: Windows, Android, WebGL" />
            </label>

            <label class="form-field">
              <span>Asset Store invoice or order info</span>
              <input type="text" name="Invoice or Order Info" placeholder="Include this for purchase or install issues" />
            </label>
          </div>

          <label class="form-field">
            <span>What happened?</span>
            <textarea
              name="Issue Summary"
              rows="4"
              placeholder="Describe the problem clearly and include any recent change that may have triggered it."
            ></textarea>
          </label>

          <label class="form-field">
            <span>Steps to reproduce</span>
            <textarea
              name="Reproduction Steps"
              rows="5"
              placeholder="List the shortest set of steps needed to reproduce the issue."
            ></textarea>
          </label>

          <label class="form-field">
            <span>Error or log information</span>
            <textarea
              name="Errors or Logs"
              rows="6"
              placeholder="Paste the exact error text or the relevant log excerpt. Raw text is more useful than a screenshot."
            ></textarea>
          </label>

          <div class="button-row">
            <button class="button" type="submit">Open Email Draft</button>
          </div>
        </form>
      </section>

      <div class="support-grid">
        <article class="support-card">
          <h2>Contact details</h2>
          <p>
            Support email: <a class="text-link" href={`mailto:${supportEmail}`}>{supportEmail}</a>
          </p>
          <p>
            If your mail app does not open from the form, send the request directly to the address above.
          </p>
        </article>
        <article class="support-card">
          <h2>What helps most</h2>
          <p>
            Paste the actual error text. Screenshots can help, but the raw message, log excerpt, and
            steps to reproduce are usually more useful.
          </p>
        </article>
        <article class="support-card">
          <h2>Purchase details</h2>
          <p>
            If the request is related to installation, updates, or account access, include the Asset Store
            invoice or order information with the message.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell support-grid">
      {backgroundBuildEnabled && (
        <article class="support-card">
          <h2>Background Build requests</h2>
          <ul>
            <li>Which build type failed: player build, AssetBundles, or Addressables</li>
            <li>Whether live log streaming was enabled</li>
            <li>Whether the build was cancelled or completed</li>
            <li>Any output-folder or build-log path details that help isolate the issue</li>
          </ul>
        </article>
      )}
      <article class="support-card">
        <h2>Smooth Operator requests</h2>
        <ul>
          <li>The exact operator usage that failed, such as `?.` or `??`</li>
          <li>The Unity object type involved</li>
          <li>Whether the object had already been destroyed</li>
          <li>A minimal code sample if the issue is reproducible</li>
        </ul>
      </article>
      <article class="support-card">
        <h2>What to attach when needed</h2>
        <p>
          Include screenshots, logs, or short sample code when they make the issue easier to reproduce.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
